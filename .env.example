# Safe local-development defaults; these are demo credentials, not production secrets.
DATABASE_URL=postgresql+asyncpg://ledgerpay:ledgerpay@localhost:5432/ledgerpay
APP_ENV=development

# Public demo protections are disabled for normal local development.
DEMO_MODE=false
DEMO_RATE_LIMIT_REQUESTS=60
DEMO_RATE_LIMIT_WINDOW_SECONDS=60
DEMO_MAX_ACCOUNTS=100

# Needed only by protected demo seeding/reset jobs. Set a private random value in deployment.
DEMO_SEED_TOKEN=
DEMO_RESET_ENABLED=false
DEMO_API_BASE_URL=http://localhost:8000
